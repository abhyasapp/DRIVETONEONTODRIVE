oauth-token.pickle
*.pickle          # any pickled credential, not just the oauth one
token.json
client_secret*.json
*.pem
*.key
credentials.json
.envrc
.secrets/


# ─── Runtime logs ───────────────────────────────────────
logs/
*.log
*.log.*

# ─── Pipeline build artifacts ───────────────────────────
