# Copy this file to .env for local runs (`.env` is gitignored).
# In CI the same values live in GitHub -> Settings -> Secrets -> Actions;
# see SECRETS.md for how to paste each one.

# --- Database (every DB step needs this) -------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Drive -------------------------------------------------------------
# Sync (Drive -> Neon) authenticates with a service-account key file:
# keep it as service-account.json in the repo root (gitignored).
# In CI the workflow writes GOOGLE_SERVICE_ACCOUNT_JSON to that file first.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Upload / chapters_up use OAuth instead: either create oauth-token.pickle
# once by running an upload interactively, or paste the one-line token JSON
# here (python -m utils.extract_token prints it).
GDRIVE_OAUTH_TOKEN=

# Optional: overrides the Drive folder that holds the source books.
# Defaults to the value in config/settings.py.
DRIVE_PARENT_ID=1_gAGILhdleeR6gBUfEFSKOVpa8x5wkCE

# --- Corrections backend (needed by the corrections step) --------------
ABHYAS_APPS_SCRIPT_URL=
ABHYAS_SYNC_KEY=

# --- Classification ----------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEY_2=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Skip the LLM step entirely: pass --skip-gemini to pipeline/run_pipeline.py
# (there is no env var for it).

# --- Legacy OAuth fallbacks (only if you do not set GDRIVE_OAUTH_TOKEN) -
OAUTH_CREDENTIALS_B64=
OAUTH_TOKEN_B64=
OAUTH_TOKEN_PICKLE=
